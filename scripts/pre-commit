#!/usr/bin/env sh
# Pre-commit gate. Install with:  cp scripts/pre-commit .git/hooks/pre-commit
# Every step must pass; there is no "skip" flag on purpose.
set -eu

cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: gofmt"
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "gofmt needed on:"
  echo "$unformatted"
  exit 1
fi

echo "pre-commit: go vet"
go vet -tags integration ./...

if command -v golangci-lint >/dev/null 2>&1; then
  echo "pre-commit: golangci-lint"
  golangci-lint run ./...
else
  echo "pre-commit: golangci-lint not installed, CI will run it"
fi

echo "pre-commit: go test"
go test -count=1 ./...

echo "pre-commit: govulncheck"
if ! command -v govulncheck >/dev/null 2>&1; then
  echo "govulncheck missing: go install golang.org/x/vuln/cmd/govulncheck@v1.8.0"
  exit 1
fi
govulncheck ./...

echo "pre-commit: ok"
